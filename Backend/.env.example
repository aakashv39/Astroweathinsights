# MongoDB Connection
# For local development (ensure MongoDB is running locally)
MONGO_URI=mongodb://localhost:27017

# For production (update with your MongoDB Atlas or managed service URI)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/astroweathinsights?retryWrites=true&w=majority

# JWT Secret Key - Keep this very secret in production
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_jwt_secret_key_here_change_in_production

# Razorpay Payment Gateway Credentials
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret_here

# Server Port (optional, defaults to 8000)
PORT=8000
